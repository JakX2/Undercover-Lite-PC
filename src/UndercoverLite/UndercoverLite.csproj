<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UndercoverLite</AssemblyName>
    <ApplicationIcon Condition="Exists('Resources\\UndercoverLite.ico')">Resources\UndercoverLite.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UndercoverLite.Core\UndercoverLite.Core.csproj" />
  </ItemGroup>
</Project>